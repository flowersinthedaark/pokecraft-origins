{
    "type": "origins:multiple",
	"size": {
		"type": "origins:action_on_callback",
		"entity_action_chosen": {
			"type": "origins:and",
			"actions": [
			{
				"type": "origins:execute_command",
				"command": "scale set pehkui:height 1.5 @s"
			},
			{
				"type": "origins:execute_command",
				"command": "scale set pehkui:width 1.5 @s"
			},
			{
				"type": "origins:execute_command",
				"command": "scale persist set true @s"
			}
			]
		},
		"entity_action_lost": {
			"type": "origins:execute_command",
			"command": "scale reset @s"
		}
	},
	"reach": {
		"type": "origins:attribute",
		"modifiers": [
			{
				"id": "avalugg:tall_block_reach",
				"attribute": "minecraft:player.block_interaction_range",
				"operation": "add_value",
				"amount": 0.5
			},
			{
				"id": "avalugg:tall_attack_reach",
				"attribute": "minecraft:player.entity_interaction_range",
				"operation": "add_value",
				"amount": 0.5
			}
		]
	},
	"name": "Titanic Proportions",
	"description": "This particular iceberg is about 3 blocks tall. You have slightly increased reach to compensate for the extra height."

}
