{
    "type": "origins:multiple",
	"size": {
		"type": "origins:action_on_callback",
		"entity_action_chosen": {
			"type": "origins:and",
			"actions": [
			{
				"type": "origins:execute_command",
				"command": "scale set pehkui:height 1.5 @s"
			},
			{
				"type": "origins:execute_command",
				"command": "scale set pehkui:width 1.5 @s"
			},
			{
				"type": "origins:execute_command",
				"command": "scale persist set true @s"
			}
			]
		},
		"entity_action_lost": {
			"type": "origins:execute_command",
			"command": "scale reset @s"
		}
	},
	"reach": {
		"type": "origins:action_on_callback",
		"entity_action_gained": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.block_interaction_reach modifier add avalugg:tall_block_reach 0.5 add_multiplied_base"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.entity_interaction_reach modifier add avalugg:tall_attack_reach 0.5 add_multiplied_base"
				}
			]
		},
		"entity_action_respawned": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.block_interaction_reach modifier add avalugg:tall_block_reach 0.5 add_value"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.entity_interaction_reach modifier add avalugg:tall_attack_reach 0.5 add_multiplied_base"
				}
			]
		},
		"entity_action_lost": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.block_interaction_reach modifier remove avalugg:tall_block_reach"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.entity_interaction_reach modifier remove avalugg:tall_attack_reach"
				}
			]
		}
	},
	"name": "Titanic Proportions",
	"description": "This particular iceberg is about 3 blocks tall. You have slightly increased reach to compensate for the extra height."
}