{
    "type": "origins:multiple",
	"size": {
		"type": "origins:action_on_callback",
		"entity_action_chosen": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "scale set pehkui:height 1.6 @s"
				},
				{
					"type": "origins:execute_command",
					"command": "scale set pehkui:width 1.6 @s"
				},
				{
					"type": "origins:execute_command",
					"command": "scale persist set true @s"
				},
				{
					"type": "origins:delay",
					"ticks": 120,
					"action": {
						"type": "origins:change_resource",
						"resource": "*:snorlax/noinsomniac_antiinsomnia",
						"change": -3
					}
				}
			]
		},
		"entity_action_lost": {
			"type": "origins:execute_command",
			"command": "scale reset @s"
		}
	},
	"reach": {
		"type": "origins:action_on_callback",
		"entity_action_gained": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:generic.movement_speed modifier add snorlax:slowww -0.2 add_multiplied_base"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.block_interaction_reach modifier add snorlax:tall_block_reach 0.6 add_multiplied_base"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.entity_interaction_reach modifier add snorlax:tall_attack_reach 0.6 add_multiplied_base"
				}
			]
		},
		"entity_action_respawned": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:generic.movement_speed modifier add snorlax:slowww -0.2 add_multiplied_base"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.block_interaction_reach modifier add snorlax:tall_block_reach 0.6 add_value"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.entity_interaction_reach modifier add snorlax:tall_attack_reach 0.6 add_multiplied_base"
				}
			]
		},
		"entity_action_lost": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:generic.movement_speed modifier remove snorlax:slowww"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.block_interaction_reach modifier remove snorlax:tall_block_reach"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:player.entity_interaction_reach modifier remove snorlax:tall_attack_reach"
				}
			]
		}
	},
	"name": "Ginormous",
	"description": "You are significantly larger at a full 3 blocks tall and notably slower, but your size allows you increased reach."
}