{
    "type": "origins:multiple",
    "geartimer1": {
        "type": "origins:cooldown",
        "cooldown": 1200,
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 0
        }
    },
	"geartimer2": {
        "type": "origins:cooldown",
        "cooldown": 600,
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 0
        }
    },
	"geartimer3": {
        "type": "origins:cooldown",
        "cooldown": 300,
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 0
        }
    },
	"geartimer4": {
        "type": "origins:cooldown",
        "cooldown": 150,
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 0
        }
    },
    "gearlevel": {
        "type": "origins:resource",
        "max": 4,
        "min": 0,
        "start_value": 0,
        "hud_render": {
			"sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
            "bar_index": 6,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_gearlevel",
                "comparison": ">",
                "compare_to": 0
            }
        }
    },
    "gearchoice": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:if_else",
                    "if_action": {
                        "type": "origins:trigger_cooldown",
                        "power": "*:*_choosing"
                    },
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:*_gearlevel",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    "else_action": {
                        "type": "origins:nothing"
                    }
                },
                {
					"type": "origins:and",
					"actions": [
						{
							"type": "origins:change_resource",
							"resource": "*:*_gearlevel",
							"change": 1
						},
						{
							"type": "origins:execute_command",
							"command": "playsound minecraft:block.note_block.cow_bell music @s"
						},
						{
							"type": "origins:execute_command",
							"command": "playsound minecraft:block.note_block.iron_xylophone music @s"
						},
						{
							"type": "origins:execute_command",
							"command": "playsound minecraft:block.lever.click music @s"
						}
					]
                }
            ]
        },
		"key": {
			"key": "key.origins.primary_active"
		},
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:resource",
					"resource": "*:*_geartimer1",
					"comparison": "==",
					"compare_to": 0
				},
				{
					"type": "origins:resource",
					"resource": "*:*_geartimer2",
					"comparison": "==",
					"compare_to": 0
				},
				{
					"type": "origins:resource",
					"resource": "*:*_geartimer3",
					"comparison": "==",
					"compare_to": 0
				},
				{
					"type": "origins:resource",
					"resource": "*:*_geartimer4",
					"comparison": "==",
					"compare_to": 0
				},
				{
					"type": "origins:resource",
					"resource": "*:*_rechargespeed",
					"comparison": "==",
					"compare_to": 0
				}
			]
		}
    },
	"choosing": {
        "type": "origins:cooldown",
        "cooldown": 60,
        "hud_render": {
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_01.png",
            "bar_index": 3
        }
    },
    "pressstart": {
        "type": "origins:action_over_time",
		"interval": 5,
        "rising_action": {
            "type": "origins:if_else_list",
            "actions": [
				{
                    "action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:trigger_cooldown",
								"power": "*:*_geartimer1"
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:item.spyglass.use",
								"pitch": 0.5
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:item.spyglass.use",
								"pitch": 0.9
							}
						]
                    },
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:*_gearlevel",
                        "comparison": "==",
                        "compare_to": 1
                    }
                },
                {
                    "action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:trigger_cooldown",
								"power": "*:*_geartimer2"
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:item.spyglass.use",
								"pitch": 0.5
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:item.spyglass.use",
								"pitch": 0.9
							}
						]
                    },
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:*_gearlevel",
                        "comparison": "==",
                        "compare_to": 2
                    }
                },
				{
                    "action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:trigger_cooldown",
								"power": "*:*_geartimer3"
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:item.spyglass.use",
								"pitch": 0.5
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:item.spyglass.use",
								"pitch": 0.9
							}
						]
                    },
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:*_gearlevel",
                        "comparison": "==",
                        "compare_to": 3
                    }
                },
				{
                    "action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:trigger_cooldown",
								"power": "*:*_geartimer4"
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:item.spyglass.use",
								"pitch": 0.5
							},
							{
								"type": "origins:play_sound",
								"sound": "minecraft:item.spyglass.use",
								"pitch": 0.9
							}
						]
                    },
                    "condition": {
                        "type": "origins:resource",
                        "resource": "*:*_gearlevel",
                        "comparison": "==",
                        "compare_to": 4
                    }
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_gearlevel",
                    "comparison": ">",
                    "compare_to": 0
                },
				{
                    "type": "origins:resource",
                    "resource": "*:*_choosing",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
	"cleargear": {
		"type": "origins:action_over_time",
		"interval": 10,
		"rising_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:change_resource",
					"resource": "*:*_gearlevel",
					"change": -5
				},
				{
					"type": "origins:trigger_cooldown",
					"power": "*:*_rechargespeed"
				},
				{
					"type": "origins:execute_command",
					"command": "attribute @s minecraft:generic.movement_speed modifier remove varoom:gearspeed"
				}
			]
		},
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:resource",
					"resource": "*:*_geartimer1",
					"comparison": "==",
					"compare_to": 0
				},
				{
					"type": "origins:resource",
					"resource": "*:*_geartimer2",
					"comparison": "==",
					"compare_to": 0
				},
				{
					"type": "origins:resource",
					"resource": "*:*_geartimer3",
					"comparison": "==",
					"compare_to": 0
				},
				{
					"type": "origins:resource",
					"resource": "*:*_geartimer4",
					"comparison": "==",
					"compare_to": 0
				}
			]
		}
	},
	"rechargespeed": {
		"type": "origins:cooldown",
		"cooldown": 1200,
		"hud_render": {
			"should_render": true,
			"sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_03.png",
			"bar_index": 17
		}
	},
	"gearspeed1": {
		"type": "origins:action_over_time",
		"rising_action": {
			"type": "origins:execute_command",
			"command": "attribute @s minecraft:generic.movement_speed modifier add varoom:gearspeed 0.08 add_multiplied_total"
		},
		"condition": {
			"type": "origins:resource",
			"resource": "*:*_geartimer1",
			"comparison": ">",
			"compare_to": 0
		}
	},
	"gearspeed2": {
		"type": "origins:action_over_time",
		"rising_action": {
			"type": "origins:execute_command",
			"command": "attribute @s minecraft:generic.movement_speed modifier add varoom:gearspeed 0.16 add_multiplied_total"
		},
		"condition": {
			"type": "origins:resource",
			"resource": "*:*_geartimer2",
			"comparison": ">",
			"compare_to": 0
		}
	},
	"gearspeed3": {
		"type": "origins:action_over_time",
		"rising_action": {
			"type": "origins:execute_command",
			"command": "attribute @s minecraft:generic.movement_speed modifier add varoom:gearspeed 0.24 add_multiplied_total"
		},
		"condition": {
			"type": "origins:resource",
			"resource": "*:*_geartimer3",
			"comparison": ">",
			"compare_to": 0
		}
	},
	"gearspeed4": {
		"type": "origins:action_over_time",
		"rising_action": {
			"type": "origins:execute_command",
			"command": "attribute @s minecraft:generic.movement_speed modifier add varoom:gearspeed 0.32 add_multiplied_total"
		},
		"condition": {
			"type": "origins:resource",
			"resource": "*:*_geartimer4",
			"comparison": ">",
			"compare_to": 0
		}
	},
	"slowdown": {
		"type": "origins:conditioned_attribute",
		"modifier": {
			"id": "varoom:slowdown",
			"attribute": "minecraft:generic.movement_speed",
			"operation": "add_multiplied_total",
			"amount": -0.5
		},
		"condition": {
			"type": "origins:and",
			"conditions": [
				{
					"type": "origins:resource",
					"resource": "*:*_rechargespeed",
					"comparison": "<=",
					"compare_to": 1200
				},
				{
					"type": "origins:resource",
					"resource": "*:*_rechargespeed",
					"comparison": ">",
					"compare_to": 600
				}
			]
		}
	},
	"badges": [
		{
			"type": "origins:tooltip",
			"sprite": "origins:textures/gui/badge/active.png",
			"text": [
				{
					"text": "Begin choosing a speed with ["
				},
				{
					"keybind": "key.origins.primary_active"
				},
				{
					"text": "], click again to up the speed"
				}
			]
		},
		{
			"type": "origins:tooltip",
			"sprite": "origins:textures/gui/badge/info.png",
			"text": "The longest speed boost lasts 1 minute"
		}
	],
	"name": "Shift Gear",
	"description": "Upon revving up, you can choose one of 4 speeds to boost yourself to. However, the time you can boost yourself for is halved every time you increase your speed and you will be immensely slowed afterward."
}